rules_version = '2';

// ═══════════════════════════════════════════════════════
//  ISL Connect — Firestore Security Rules
//  Last updated: 2026-07-08
//  Auth methods: Email/Password + Google OAuth
//  Collections: users, users/{uid}/progress
// ═══════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function validUid(userId) {
      return request.resource.data.uid == userId;
    }

    // ── /users/{userId} ──────────────────────────────────
    match /users/{userId} {

      // READ: Only the user can read their own document.
      allow read: if isOwner(userId);

      // CREATE: Only the authenticated user can create their OWN document.
      allow create: if isOwner(userId)
        && validUid(userId)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      // UPDATE: A user can only update their OWN document.
      // Cannot change uid, email, or createdAt (identity / audit fields).
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      // DELETE: Disabled for safety.
      allow delete: if false;

      // ── /users/{userId}/progress/{lessonId} ────────────
      // Stores per-lesson completion records.
      // Each document: { lessonId: string, completedAt: Timestamp }
      match /progress/{lessonId} {

        // READ: Only the owning user can read their own progress.
        allow read: if isOwner(userId);

        // WRITE: Only the owning user can mark lessons complete.
        // Only allowed fields: lessonId (string) and completedAt (timestamp).
        allow write: if isOwner(userId)
          && hasOnlyAllowedFields(['lessonId', 'completedAt'])
          && request.resource.data.lessonId is string;

        // DELETE: Disabled — progress records are permanent.
        allow delete: if false;
      }

      // ── Deny any other subcollections ──────────────────
      // Any subcollection not explicitly listed above is DENIED.
      match /{otherSubcollection=**} {
        allow read, write: if false;
      }
    }

    // ── Catch-all: deny everything else ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

